{
  "name": "github-reserved-names",
  "version": "2.2.0",
  "description": "Get a list, or check if a user or organization name is reserved by GitHub",
  "license": "MIT",
  "repository": "Mottie/github-reserved-names",
  "author": {
    "name": "Rob Garrison",
    "email": "wowmotty@gmail.com"
  },
  "scripts": {
    "test": "xo && ava"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "reserved-names.json",
    "oddballs.json"
  ],
  "types": "./index.d.ts",
  "keywords": [
    "github",
    "reserved",
    "username",
    "organization"
  ],
  "xo": {
    "rules": {
      "unicorn/prefer-module": 0,
      "@stylistic/quotes": [
        "error",
        "double"
      ],
      "import-x/order": 0
    }
  },
  "ava": {
    "serial": true,
    "timeout": "120s"
  },
  "devDependencies": {
    "ava": "^8.0.0",
    "xo": "^2.0.2"
  }
}
